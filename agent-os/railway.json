{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "dockerfile": "./Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "npm start",
    "healthchecks": {
      "enabled": true,
      "interval": 30,
      "timeout": 10
    }
  },
  "variables": {
    "PORT": "3000",
    "NODE_ENV": "production"
  },
  "plugins": [
    {
      "name": "postgres",
      "type": "postgres"
    },
    {
      "name": "redis",
      "type": "redis"
    }
  ],
  "repo": "https://github.com/TumeloRamaphosa/studex-auto-meat",
  "repoSubPath": "agent-os"
}
