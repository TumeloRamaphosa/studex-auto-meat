# === STUDEX AGENT OS — Environment Configuration ===

# Server
PORT=3000
NODE_ENV=production

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/studex_agent_os
REDIS_HOST=localhost
REDIS_PORT=6379

# Local Models (Ollama + LM Studio)
OLLAMA_BASE_URL=http://localhost:11434
LM_STUDIO_URL=http://localhost:1234

# Active Model Selection
ACTIVE_MODEL=qwen2.5-14b

# Available models: gemma-4, qwen2.5-14b, qwen3-14b, mistral-small-3.1, devstral-small, gemma-4-26b

# Cloud LLMs
ANTHROPIC_API_KEY=sk-ant-...
PERPLEXITY_API_KEY=...

# Content Generation
COMFYUI_URL=http://localhost:8188
HIGGSFIELD_API_KEY=...

# Integrations
SHOPIFY_API_URL=https://your-store.myshopify.com/admin/api/2024-01
SHOPIFY_API_TOKEN=shpat_...
NOTION_API_KEY=notionauthkey_...
CLICKUP_API_KEY=pk_...
BLOTATO_API_KEY=blt_...
BASE44_API_KEY=...
AGENTMAIL_API_KEY=...

# Buzz Agent Community
BUZZ_ENDPOINT=wss://studex-agents.communities.buzz.xyz
BUZZ_AUTH_TOKEN=...
BUZZ_GROUP_ID=studex-agents

# Infrastructure
OBSIDIAN_VAULT_PATH=~/Documents/Obsidian Vault/2nd Brain
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook
CLOUDFLARE_TUNNEL_TOKEN=...
CLOUDFLARE_ACCOUNT_ID=...

# Deployment
RAILWAY_API_TOKEN=...
GITHUB_TOKEN=...
